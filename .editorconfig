# EditorConfig — root for InfraFlowSculptor
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
# ── Naming styles ──
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_prefix_style.required_prefix = _
dotnet_naming_style.underscore_prefix_style.capitalization = camel_case

# ── Code quality — relax noisy rules while keeping valuable ones ──

# CA1002: Do not expose generic lists — too strict for DTOs/contracts
dotnet_diagnostic.CA1002.severity = none
# CA1024: Use properties where appropriate — too strict
dotnet_diagnostic.CA1024.severity = none
# CA1032: Implement standard exception constructors
dotnet_diagnostic.CA1032.severity = none
# CA1034: Nested types should not be visible — we use nested types for VOs/enums
dotnet_diagnostic.CA1034.severity = none
# CA1054/CA1055/CA1056: URI parameters/returns should not be strings
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none
# CA1062: Validate arguments of public methods — handled by nullable reference types
dotnet_diagnostic.CA1062.severity = none
# CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1303.severity = none
# CA1304/CA1305/CA1310/CA1311: Specify culture/StringComparison — too verbose for internal code
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1311.severity = none
# CA1515: Consider making public types internal — we expose public types intentionally
dotnet_diagnostic.CA1515.severity = none
# CA1707: Identifiers should not contain underscores — conflicts with test naming
dotnet_diagnostic.CA1707.severity = none
# CA1711: Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1711.severity = none
# CA1716: Identifiers should not match keywords
dotnet_diagnostic.CA1716.severity = none
# CA1724: Type names should not match namespaces
dotnet_diagnostic.CA1724.severity = none
# CA1812: Avoid uninstantiated internal classes — false positive on DI-resolved types
dotnet_diagnostic.CA1812.severity = none
# CA1819: Properties should not return arrays
dotnet_diagnostic.CA1819.severity = none
# CA1848: Use LoggerMessage delegates — future improvement
dotnet_diagnostic.CA1848.severity = suggestion
# CA1861: Avoid constant arrays as arguments
dotnet_diagnostic.CA1861.severity = suggestion
# CA2007: Do not directly await a Task — we use ConfigureAwait(false) where needed
dotnet_diagnostic.CA2007.severity = none
# CA2225: Operator overloads have named alternates — too strict for VOs
dotnet_diagnostic.CA2225.severity = none
# CA2227: Collection properties should be read only
dotnet_diagnostic.CA2227.severity = none
# CA1000: Do not declare static members on generic types — Id<T>.Create pattern
dotnet_diagnostic.CA1000.severity = none
# CA1008: Enums should have value named None — domain enums don't need None
dotnet_diagnostic.CA1008.severity = none
# CA1040: Avoid empty interfaces — marker interfaces are intentional (ICommandBase, etc.)
dotnet_diagnostic.CA1040.severity = none
# CA1307: Specify StringComparison — too verbose for internal code
dotnet_diagnostic.CA1307.severity = none
# CA1308: Normalize strings to uppercase — string normalization is a domain choice
dotnet_diagnostic.CA1308.severity = none
# CA1720: Identifier contains type name — too strict for domain entities
dotnet_diagnostic.CA1720.severity = none
# CA1802: Use literals where appropriate — defer to incremental cleanup
dotnet_diagnostic.CA1802.severity = suggestion
# CA1826: Do not use Enumerable methods on indexable collections
dotnet_diagnostic.CA1826.severity = suggestion
# CA1834: Consider using StringBuilder.Append(char)
dotnet_diagnostic.CA1834.severity = suggestion
# CA1859: Use concrete types when possible — defer to incremental refactoring
dotnet_diagnostic.CA1859.severity = suggestion
# CA1031: Do not catch general exception types — existing catch-all handlers are intentional
dotnet_diagnostic.CA1031.severity = suggestion
# CA1051: Do not declare visible instance fields
dotnet_diagnostic.CA1051.severity = suggestion
# CA1823: Avoid unused private fields
dotnet_diagnostic.CA1823.severity = suggestion
# CA1849: Call async methods when in an async method
dotnet_diagnostic.CA1849.severity = suggestion
# CA1873: Avoid redundant string length comparison
dotnet_diagnostic.CA1873.severity = suggestion
# CA2234: Pass System.Uri objects instead of strings
dotnet_diagnostic.CA2234.severity = suggestion
# CA1805: Do not initialize unnecessarily — `= null!` is intentional for EF Core properties
dotnet_diagnostic.CA1805.severity = none
# CA1019: Define accessors for attribute arguments — too strict for custom attributes
dotnet_diagnostic.CA1019.severity = suggestion
# CS1734: XML comment parameter reference
dotnet_diagnostic.CS1734.severity = suggestion
# CA2016: Forward CancellationToken to methods — defer to incremental improvement
dotnet_diagnostic.CA2016.severity = suggestion
# CS1587: XML comment is not placed on a valid language element
dotnet_diagnostic.CS1587.severity = suggestion
# CA1068: CancellationToken should be last parameter — existing signatures are stable
dotnet_diagnostic.CA1068.severity = suggestion
# CA1862: Use string.Equals with StringComparison
dotnet_diagnostic.CA1862.severity = suggestion
# CA1863: Use CompositeFormat
dotnet_diagnostic.CA1863.severity = suggestion

# IDE0005: Remove unnecessary usings
dotnet_diagnostic.IDE0005.severity = warning
# IDE0058: Expression value is never used
dotnet_diagnostic.IDE0058.severity = none
# IDE0060: Remove unused parameter
dotnet_diagnostic.IDE0060.severity = suggestion
# IDE0130: Namespace does not match folder structure
dotnet_diagnostic.IDE0130.severity = suggestion
# IDE0290: Use primary constructor
dotnet_diagnostic.IDE0290.severity = none

# ── Documentation ──
# CS1591: Missing XML comment — not enforced globally; add docs incrementally
dotnet_diagnostic.CS1591.severity = suggestion
# CS1573: Parameter has no matching param tag
dotnet_diagnostic.CS1573.severity = suggestion
# CS1574: XML comment has cref that could not be found
dotnet_diagnostic.CS1574.severity = suggestion

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
